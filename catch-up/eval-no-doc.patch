-    const parsed = new URL(url);
-    parsed.hostname = parsed.hostname.toLowerCase();
-    parsed.pathname = parsed.pathname.replace(/\/+$/, '') || '/';
-    return parsed.toString();
-  } catch {
-    return url;
-  }
-}
-
-const hasToken = (cell, token) => new RegExp(`(^|[^0-9.])${token.replace(/[.*+?^${}()|[\]\\/]/g, '\\$&')}(?![0-9])`).test(cell);
